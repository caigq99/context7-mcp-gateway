# Copy to .env (chmod 600) and replace every placeholder. Never commit .env.
APP_ENV=production
PUBLIC_ORIGIN=https://gateway.example.com
GATEWAY_BIND=0.0.0.0:8787
DATABASE_PATH=/srv/gateway/data/context7_gateway.sqlite3
WEB_DIST_DIR=/srv/gateway/web/dist

# Generate each as an independent 32-byte base64url value (without padding).
GATEWAY_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64URL_SECRET
GATEWAY_TOKEN_PEPPER=REPLACE_WITH_A_DIFFERENT_RANDOM_32_BYTE_BASE64URL_SECRET

# Required for the current production startup configuration. Use the exact callback URL.
DEFAULT_UPSTREAM_POOL_ID=REPLACE_WITH_EXISTING_POOL_ID
LINUXDO_OAUTH_ENABLED=true
LINUXDO_OAUTH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
LINUXDO_OAUTH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
LINUXDO_OAUTH_REDIRECT_URL=https://gateway.example.com/auth/linuxdo/callback
LINUXDO_OAUTH_SCOPE=openid profile

# Nonsecret retention setting. Defaults to 30; allowed range: 1-365 days.
GATEWAY_EVENT_RETENTION_DAYS=30

# Development/test-only fixed upstream overrides for a loopback Context7 mock.
# Production refuses any non-empty override and always uses the official origins.
# CONTEXT7_MCP_ORIGIN=http://127.0.0.1:19090
# CONTEXT7_REST_ORIGIN=http://127.0.0.1:19090

# Optional development/test-only local payment callback fixture; keep empty to hide order checkout.
# Generate a distinct 32-byte base64url secret without padding. Production disables this provider.
GATEWAY_BILLING_SANDBOX_SECRET=
